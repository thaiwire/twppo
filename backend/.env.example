# SQL Server connection (Prisma CLI uses DATABASE_URL; runtime uses DB_* below)
DATABASE_URL="sqlserver://192.9.200.132:1433;database=dbmtp;user=sa;password={YOUR_PASSWORD};encrypt=true;trustServerCertificate=true"
DB_HOST=192.9.200.132
DB_PORT=1433
DB_NAME=dbmtp
DB_USER=sa
# ครอบด้วย ' ' เสมอ — ถ้ารหัสผ่านมี # แล้วไม่ครอบ dotenv จะตัดตั้งแต่ # ทิ้ง (login ไม่ผ่าน)
DB_PASSWORD='YOUR_PASSWORD'

PORT=4000
# server จริง: HOST=127.0.0.1 (รับเฉพาะจากเครื่องตัวเอง ผ่าน IIS) / เครื่อง dev: ไม่ต้องใส่
# HOST=127.0.0.1
# สุ่มยาว ๆ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES=12h

# role ที่อนุมัติ PR / จัดการข้อมูลหลักได้ (ค่าเริ่มต้นตามนี้)
# APPROVER_ROLES=admin,manager
# MASTER_ROLES=admin,manager

# FastReport service (report/ project) — port ต้องตรงกับ PORT ใน report/.env
REPORT_URL=http://localhost:5100
