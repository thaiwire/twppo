<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" DoublePass="true" ReportInfo.Name="Items" ReportInfo.Author="mtp_po_web">
  <Dictionary>
    <TableDataSource Name="Header" ReferenceName="Data.Header" DataType="System.Int32" Enabled="true">
      <Column Name="Title" DataType="System.String"/>
      <Column Name="Filter" DataType="System.String"/>
      <Column Name="Note" DataType="System.String"/>
      <Column Name="PrintedBy" DataType="System.String"/>
      <Column Name="PrintedAt" DataType="System.String"/>
      <Column Name="Count" DataType="System.Decimal"/>
      <Column Name="Total" DataType="System.Decimal"/>
    </TableDataSource>
    <TableDataSource Name="Rows" ReferenceName="Data.Rows" DataType="System.Int32" Enabled="true">
      <Column Name="No" DataType="System.Decimal"/>
      <Column Name="Code" DataType="System.String"/>
      <Column Name="Name" DataType="System.String"/>
      <Column Name="Group" DataType="System.String"/>
      <Column Name="Um" DataType="System.String"/>
      <Column Name="Price" DataType="System.Decimal"/>
      <Column Name="StdCost" DataType="System.Decimal"/>
      <Column Name="CurCost" DataType="System.Decimal"/>
      <Column Name="Vend" DataType="System.String"/>
      <Column Name="Site" DataType="System.String"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="297" PaperHeight="210" Landscape="true" LeftMargin="10" TopMargin="10" RightMargin="10" BottomMargin="10">
    <PageHeaderBand Name="PageHeader1" Width="1047" Height="92">
