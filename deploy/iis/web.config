<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy สำหรับระบบ PR (ต้องติดตั้ง URL Rewrite 2.1 + Application Request Routing 3.0 และเปิด proxy ใน ARR)
  วางไฟล์นี้ในโฟลเดอร์ของ IIS site (เช่น C:\inetpub\mtp-pr\web.config) — site ไม่ต้องมีไฟล์อื่น

    https://pr.company.local/api/*  →  http://127.0.0.1:4000/api/*   (NestJS ตรง ไม่ผ่าน Next.js)
    https://pr.company.local/*      →  http://127.0.0.1:3000/*       (Next.js)
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1) บังคับ HTTPS (ลบ rule นี้ถ้ายังไม่มี certificate / ใช้ http อย่างเดียว) -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2) API → NestJS -->
        <rule name="API to NestJS" stopProcessing="true">
          <match url="^api/(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:4000/api/{R:1}" />
        </rule>

        <!-- 3) หน้าเว็บทั้งหมด → Next.js -->
        <rule name="Web to Next.js" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- เลขที่ PR เดิมมี "/" ซึ่งส่งเป็น %2F — ให้ IIS ยอมรับ URL ที่มีอักขระพิเศษที่ encode แล้ว -->
    <security>
      <requestFiltering allowDoubleEscaping="true" />
    </security>

    <!-- ไม่ให้ IIS แทนหน้า error ของ API (ข้อความ error เป็น JSON ภาษาไทยจาก NestJS) -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
